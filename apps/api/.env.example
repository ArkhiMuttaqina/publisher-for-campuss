PORT=3000
MEDIA_STORAGE_DIR="uploads"
MEDIA_PUBLIC_BASE_URL="http://localhost:3000/media"
PUBLIC_SITE_URL="http://localhost:3001"

DB_HOST=127.0.0.1
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=publisher_platform
DB_PORT=5432
DB_SSL=false
DB_LOGGING=false

# Optional override for Prisma CLI/runtime. If omitted, the app builds the URL from DB_* variables.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/publisher_platform"

JWT_SECRET="change-this-in-production"
JWT_EXPIRES_IN_SECONDS=3600
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
 